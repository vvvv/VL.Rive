Font*=nint
AudioSource*=nint
RenderContext*=nint
RenderTarget*=nint
Renderer*=nint
Artboard*=nint
ArtboardInstance*=nint
BindableArtboard*=nint
StateMachine*=nint
Animation*=nint
Scene*=nint
ViewModelRuntime*=nint
ViewModelInstance*=nint
ViewModelInstanceRuntime*=nint
ViewModelInstanceValueRuntime*=nint
ViewModelInstanceNumberRuntime*=nint
ViewModelInstanceStringRuntime*=nint
ViewModelInstanceEnumRuntime*=nint
ViewModelInstanceBooleanRuntime*=nint
ViewModelInstanceColorRuntime*=nint
ViewModelInstanceTriggerRuntime*=nint
ViewModelInstanceListRuntime*=nint
ViewModelInstanceAssetImageRuntime*=nint
ViewModelInstanceArtboardRuntime*=nint
SMIInput*=nint

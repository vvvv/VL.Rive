<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Run on a newer runtime if the one this targets is not installed (e.g. a CI agent) -->
    <RollForward>Major</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.*" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.*" />
    <!-- VL.Rive references these privately, so tests need them to run. No VL app host or test framework needed. -->
    <PackageReference Include="VL.Core" Version="2026.8.0-0296-g8e308ce467" />
    <PackageReference Include="VL.Stride.Runtime" Version="2026.8.0-0296-g8e308ce467" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\VL.Rive.csproj" />
  </ItemGroup>

  <!-- The native runtime of this machine, next to the test assembly where DllImport("rive_interop") finds it -->
  <PropertyGroup>
    <NativeRid Condition="'$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture)' == 'Arm64'">win-arm64</NativeRid>
    <NativeRid Condition="'$(NativeRid)' == ''">win-x64</NativeRid>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\..\runtimes\$(NativeRid)\native\rive_interop.dll" Link="rive_interop.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\help\assets\*.riv" Link="assets\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
